{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reconforge.local/schemas/acquisition-purchase-price-allocation-v1.schema.json",
  "title": "ReconForge acquisition purchase-price allocation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "acquisition_id", "algorithm_version", "book_net_assets", "bridge",
    "fair_value_adjustment", "fair_value_net_assets", "items", "posted",
    "reporting_currency", "request_digest", "result_digest", "schema_version"
  ],
  "properties": {
    "acquisition_id": {"type": "string", "minLength": 1},
    "algorithm_version": {"const": "acquisition-purchase-price-allocation-v1"},
    "book_net_assets": {"$ref": "#/$defs/money"},
    "fair_value_adjustment": {"$ref": "#/$defs/money"},
    "fair_value_net_assets": {"$ref": "#/$defs/money"},
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/item"}
    },
    "bridge": {"$ref": "#/$defs/bridge"},
    "posted": {"const": false},
    "reporting_currency": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{2,5}$"},
    "request_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "result_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "schema_version": {"const": 1}
  },
  "$defs": {
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "amount", "currency", "minor_units",
        "rounding_policy", "currency_policy_digest", "currency_registry_version",
        "currency_registry_digest"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "amount": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
        "currency": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{2,5}$"},
        "minor_units": {"type": "integer", "minimum": 0, "maximum": 8},
        "rounding_policy": {"const": "ROUND_HALF_UP"},
        "currency_policy_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "currency_registry_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "currency_registry_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_code", "book_value", "class_code", "fair_value",
        "fair_value_adjustment", "item_id", "item_kind", "source_reference",
        "valuation_reference"
      ],
      "properties": {
        "account_code": {"type": "string", "minLength": 1},
        "book_value": {"$ref": "#/$defs/money"},
        "class_code": {"type": "string", "minLength": 1},
        "fair_value": {"$ref": "#/$defs/money"},
        "fair_value_adjustment": {"$ref": "#/$defs/money"},
        "item_id": {"type": "string", "minLength": 1},
        "item_kind": {"enum": ["asset", "liability"]},
        "source_reference": {"type": "string", "minLength": 1},
        "valuation_reference": {"type": "string", "minLength": 1}
      }
    },
    "bridge_line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account_code", "amount", "line_type", "source_reference"],
      "properties": {
        "account_code": {"type": "string", "minLength": 1},
        "amount": {"$ref": "#/$defs/money"},
        "line_type": {"enum": ["consideration", "nci", "identifiable_net_assets", "goodwill", "bargain_purchase"]},
        "source_reference": {"type": "string", "minLength": 1}
      }
    },
    "bridge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acquisition_id", "algorithm_version", "bargain_purchase", "goodwill",
        "lines", "posted", "reporting_currency", "request_digest", "result_digest", "schema_version"
      ],
      "properties": {
        "acquisition_id": {"type": "string", "minLength": 1},
        "algorithm_version": {"const": "acquisition-fair-value-goodwill-bridge-v1"},
        "bargain_purchase": {"$ref": "#/$defs/money"},
        "goodwill": {"$ref": "#/$defs/money"},
        "lines": {"type": "array", "minItems": 3, "maxItems": 5, "items": {"$ref": "#/$defs/bridge_line"}},
        "posted": {"const": false},
        "reporting_currency": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{2,5}$"},
        "request_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "result_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "schema_version": {"const": 1}
      }
    }
  }
}
