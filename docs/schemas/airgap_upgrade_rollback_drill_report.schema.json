{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reconforge.local/schemas/airgap_upgrade_rollback_drill_report.schema.json",
  "title": "ReconForge no-network tagged application upgrade and rollback drill",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "executed_at", "runtime", "transition", "verification", "scope_status", "limitations"],
  "properties": {
    "schema": {"const": "reconforge-airgap-upgrade-rollback-drill-report-v1"},
    "executed_at": {"const": "2026-07-30"},
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["container_image", "container_image_digest", "network_mode", "root_filesystem", "wheel_mounts", "writable_state"],
      "properties": {
        "container_image": {"const": "python:3.14.1-slim"},
        "container_image_digest": {"const": "sha256:b823ded4377ebb5ff1af5926702df2284e53cecbc6e3549e93a19d8632a1897e"},
        "network_mode": {"const": "none"},
        "root_filesystem": {"const": "read-only"},
        "wheel_mounts": {"const": "read-only"},
        "writable_state": {"const": "bounded-tmpfs-only"}
      }
    },
    "transition": {
      "type": "object", "additionalProperties": false,
      "required": ["from_version", "to_version", "source_wheel_sha256", "target_wheel_sha256", "compatibility_reader"],
      "properties": {
        "from_version": {"const": "0.7.0"},
        "to_version": {"const": "0.7.1"},
        "source_wheel_sha256": {"const": "7ec21a8fe7cb299857414f10d98f94743274054a937a7fa910d1ae3cb0ca86ef"},
        "target_wheel_sha256": {"const": "55d0bbc93d2493409ea38c7d7de45bc901ab70587087cec45fdeb7fb3c5c2fc4"},
        "compatibility_reader": {"const": "wheel-import-v1"}
      }
    },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["offline_pip", "cutover_verified", "target_content_sha256", "rollback_exact", "rollback_sha256", "doctor_exit_zero", "cleanup_complete"],
      "properties": {
        "offline_pip": {"const": "--no-index --no-deps"},
        "cutover_verified": {"const": true},
        "target_content_sha256": {"const": "be1890980fadc829aaddc43ea927567226fde0b8b3bc9dce8190205f3477ee3a"},
        "rollback_exact": {"const": true},
        "rollback_sha256": {"const": "5de3b0a06852daa97666aadb939bc0daca0254d7363208ec0a8da2420edd347b"},
        "doctor_exit_zero": {"const": true},
        "cleanup_complete": {"const": true}
      }
    },
    "scope_status": {"const": "verified-no-network-tagged-application-cutover-and-exact-rollback"},
    "limitations": {
      "type": "array", "minItems": 5, "uniqueItems": true,
      "items": {"enum": ["application_resource_only", "connected_wheel_assembly_precedes_disconnected_consumption", "single_runtime_single_run", "no_zero_downtime_claim", "no_production_readiness_claim"]}
    }
  }
}
