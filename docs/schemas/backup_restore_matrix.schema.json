{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reconforge.local/schemas/backup_restore_matrix.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "overall_status", "cells"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "format": "date"},
    "overall_status": {"enum": ["planned", "partial", "verified"]},
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "edition", "backend", "source_version", "target_version", "status", "encryption", "authorization", "integrity", "rollback", "evidence", "limitations"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
          "edition": {"enum": ["community", "team", "enterprise", "regulated"]},
          "backend": {"enum": ["sqlite", "postgresql"]},
          "source_version": {"type": "string", "minLength": 1, "maxLength": 80},
          "target_version": {"type": "string", "minLength": 1, "maxLength": 80},
          "status": {"enum": ["planned", "partial", "verified"]},
          "encryption": {"type": "string", "minLength": 1, "maxLength": 300},
          "authorization": {"type": "string", "minLength": 1, "maxLength": 300},
          "integrity": {"type": "string", "minLength": 1, "maxLength": 300},
          "rollback": {"type": "string", "minLength": 1, "maxLength": 300},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
