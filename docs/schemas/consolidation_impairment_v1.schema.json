{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reconforge.local/schemas/consolidation-impairment-v1.schema.json",
  "title": "ReconForge consolidation impairment bridge v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "algorithm_version", "impairment_test_id", "posted", "reporting_currency",
    "request_digest", "result_digest", "schema_version", "total_carrying_amount",
    "total_impairment_loss", "total_recoverable_amount", "units"
  ],
  "properties": {
    "algorithm_version": {"const": "consolidation-impairment-bridge-v1"},
    "impairment_test_id": {"type": "string", "minLength": 1},
    "posted": {"const": false},
    "reporting_currency": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{2,5}$"},
    "request_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "result_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "schema_version": {"const": 1},
    "total_carrying_amount": {"$ref": "#/$defs/money"},
    "total_impairment_loss": {"$ref": "#/$defs/money"},
    "total_recoverable_amount": {"$ref": "#/$defs/money"},
    "units": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/unit"}}
  },
  "$defs": {
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "amount", "currency", "minor_units", "rounding_policy",
        "currency_policy_digest", "currency_registry_version", "currency_registry_digest"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "amount": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
        "currency": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{2,5}$"},
        "minor_units": {"type": "integer", "minimum": 0, "maximum": 8},
        "rounding_policy": {"const": "ROUND_HALF_UP"},
        "currency_policy_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "currency_registry_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "currency_registry_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_code", "carrying_amount", "impairment_loss", "recoverable_amount",
        "recoverable_headroom", "source_digest", "source_reference", "status", "unit_id", "unit_kind"
      ],
      "properties": {
        "account_code": {"type": "string", "minLength": 1},
        "carrying_amount": {"$ref": "#/$defs/money"},
        "impairment_loss": {"$ref": "#/$defs/money"},
        "recoverable_amount": {"$ref": "#/$defs/money"},
        "recoverable_headroom": {"$ref": "#/$defs/money"},
        "source_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_reference": {"type": "string", "minLength": 1},
        "status": {"enum": ["impaired", "not_impaired"]},
        "unit_id": {"type": "string", "minLength": 1},
        "unit_kind": {"enum": ["goodwill", "asset"]}
      }
    }
  }
}
