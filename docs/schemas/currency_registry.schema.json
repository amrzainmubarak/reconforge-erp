{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reconforge.org/schemas/currency_registry.schema.json",
  "title": "ReconForge Currency Policy Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_version",
    "published_at",
    "source",
    "source_url",
    "currencies"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "registry_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]{0,127}$"
    },
    "published_at": {
      "type": "string",
      "maxLength": 32
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "source_url": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^(|https://.+)$"
    },
    "default_rounding_policy": {
      "$ref": "#/$defs/roundingPolicy"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "currencies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/currency"
      }
    }
  },
  "$defs": {
    "roundingPolicy": {
      "type": "string",
      "enum": ["ROUND_HALF_UP"]
    },
    "currency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name", "minor_units"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "minor_units": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "numeric_code": {
          "type": "string",
          "pattern": "^(|[0-9]{3})$"
        },
        "symbol": {
          "type": "string",
          "maxLength": 16
        },
        "rounding_policy": {
          "$ref": "#/$defs/roundingPolicy"
        }
      }
    }
  }
}
