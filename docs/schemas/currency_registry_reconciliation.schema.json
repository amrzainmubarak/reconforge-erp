{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reconforge.local/schemas/currency_registry_reconciliation.schema.json",
  "title": "ReconForge Currency Registry Reconciliation",
  "description": "Read-only, digest-bound comparison of master-data currency policies with the installed registry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "status",
    "ok",
    "registry",
    "master_currency_count",
    "active_master_currency_count",
    "input_digest",
    "issues",
    "binding"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "scope": {"type": "string", "minLength": 1, "maxLength": 160},
    "status": {"enum": ["consistent", "inconsistent"]},
    "ok": {"type": "boolean"},
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_version", "digest"],
      "properties": {
        "registry_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "master_currency_count": {"type": "integer", "minimum": 0, "maximum": 100000},
    "active_master_currency_count": {"type": "integer", "minimum": 0, "maximum": 100000},
    "input_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "binding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {"status": {"const": "unbound"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "registry_version", "registry_digest", "bound_at", "bound_by"],
          "properties": {
            "status": {"enum": ["current", "drifted"]},
            "registry_version": {"type": "string", "minLength": 1, "maxLength": 128},
            "registry_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "bound_at": {"type": "string", "minLength": 1, "maxLength": 64},
            "bound_by": {"type": "string", "minLength": 1, "maxLength": 160}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "registry_version", "registry_digest"],
          "properties": {
            "status": {"const": "invalid"},
            "registry_version": {"type": "string", "maxLength": 128},
            "registry_digest": {"type": "string", "maxLength": 64}
          }
        }
      ]
    },
    "issues": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "currency_code", "message"],
        "properties": {
          "code": {"enum": ["master_currency_invalid", "master_currency_duplicate", "registry_currency_missing", "minor_units_mismatch", "registry_binding_invalid"]},
          "currency_code": {"type": "string", "minLength": 1, "maxLength": 16},
          "message": {"type": "string", "minLength": 1, "maxLength": 200},
          "master_minor_units": {"type": "integer", "minimum": 0, "maximum": 6},
          "registry_minor_units": {"type": "integer", "minimum": 0, "maximum": 6}
        }
      }
    }
  }
}
