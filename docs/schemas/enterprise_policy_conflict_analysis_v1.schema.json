{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reconforge.local/schemas/enterprise-policy-conflict-analysis-v1.schema.json",
  "title": "ReconForge enterprise policy conflict analysis v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "active_grant_count", "algorithm_version", "findings", "policy_id",
    "policy_version", "request_digest", "result_digest", "revoked_grant_count",
    "schema_version", "status"
  ],
  "properties": {
    "active_grant_count": {"type": "integer", "minimum": 0},
    "algorithm_version": {"const": "enterprise-policy-conflict-analysis-v1"},
    "findings": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/finding"}},
    "policy_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "policy_version": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"},
    "request_digest": {"$ref": "#/$defs/sha256"},
    "result_digest": {"$ref": "#/$defs/sha256"},
    "revoked_grant_count": {"type": "integer", "minimum": 0},
    "schema_version": {"const": 1},
    "status": {"enum": ["clear", "conflicts"]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "conflict_id", "grant_ids", "permissions", "principal_id", "reason", "scope_digests", "severity"],
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 160},
        "conflict_id": {"$ref": "#/$defs/sha256"},
        "grant_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "permissions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "principal_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "reason": {"type": "string", "minLength": 1, "maxLength": 500},
        "scope_digests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha256"}},
        "severity": {"enum": ["critical", "high", "medium"]}
      }
    }
  }
}
