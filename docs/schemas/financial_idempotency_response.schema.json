{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reconforge.local/schemas/financial-idempotency-response-object-v1",
  "title": "ReconForge Financial Idempotency Response Object v1",
  "description": "Structural contract for bounded AP/AR idempotency responses. Fractional financial values are represented as exact text; JSON number tokens are integers only.",
  "$ref": "#/$defs/object",
  "$defs": {
    "value": {
      "oneOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "string"},
        {"type": "integer"},
        {"$ref": "#/$defs/array"},
        {"$ref": "#/$defs/object"}
      ]
    },
    "array": {
      "type": "array",
      "items": {"$ref": "#/$defs/value"},
      "maxItems": 25000
    },
    "object": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/value"},
      "maxProperties": 25000
    }
  }
}
