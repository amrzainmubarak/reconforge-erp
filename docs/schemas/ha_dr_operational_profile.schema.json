{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reconforge.local/schemas/ha_dr_operational_profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "status", "source_report", "targets", "observed", "verification", "runbook", "limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "profile_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
    "status": {"enum": ["partial", "verified"]},
    "source_report": {"type": "string", "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)+$"},
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rpo_transactions", "failover_rto_seconds", "failback_rto_seconds"],
      "properties": {
        "rpo_transactions": {"type": "integer", "minimum": 0},
        "failover_rto_seconds": {"type": "number", "exclusiveMinimum": 0},
        "failback_rto_seconds": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_count", "zero_loss_runs", "failover_rto_max_seconds", "failback_rto_max_seconds", "failure_domains"],
      "properties": {
        "run_count": {"type": "integer", "minimum": 1},
        "zero_loss_runs": {"type": "integer", "minimum": 0},
        "failover_rto_max_seconds": {"type": "number", "exclusiveMinimum": 0},
        "failback_rto_max_seconds": {"type": "number", "exclusiveMinimum": 0},
        "failure_domains": {"type": "integer", "minimum": 1}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independent_failure_domains",
        "quorum_or_witness",
        "automatic_failover",
        "backup_restore_integrity",
        "repeated_integrity",
        "rpo_rto_observed",
        "production_slo"
      ],
      "properties": {
        "independent_failure_domains": {"type": "boolean"},
        "quorum_or_witness": {"type": "boolean"},
        "automatic_failover": {"type": "boolean"},
        "backup_restore_integrity": {"type": "boolean"},
        "repeated_integrity": {"type": "boolean"},
        "rpo_rto_observed": {"type": "boolean"},
        "production_slo": {"type": "boolean"}
      }
    },
    "runbook": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 300}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "verified"}}},
      "then": {
        "properties": {
          "verification": {
            "properties": {
              "independent_failure_domains": {"const": true},
              "quorum_or_witness": {"const": true},
              "automatic_failover": {"const": true},
              "backup_restore_integrity": {"const": true},
              "repeated_integrity": {"const": true},
              "rpo_rto_observed": {"const": true},
              "production_slo": {"const": true}
            }
          }
        }
      }
    }
  ]
}
