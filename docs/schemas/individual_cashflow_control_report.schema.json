{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reconforge.local/schemas/individual_cashflow_control_report.schema.json",
  "title": "ReconForge Individual Cashflow Control Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["algorithm_version", "artifact_digest", "artifact_type", "decision_digest", "decisions", "input_digests", "schema_version", "status_counts"],
  "properties": {
    "algorithm_version": {"const": "individual-cashflow-control-v1"},
    "artifact_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact_type": {"const": "reconforge-individual-cashflow-control"},
    "decision_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "input_digests": {"type": "array", "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "uniqueItems": true},
    "schema_version": {"const": 1},
    "status_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}}
  },
  "$defs": {
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency", "currency_policy_digest", "currency_registry_digest", "currency_registry_version", "minor_units", "rounding_policy", "schema_version"],
      "properties": {
        "amount": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "currency_policy_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "currency_registry_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "currency_registry_version": {"type": "string", "minLength": 1},
        "minor_units": {"type": "integer", "minimum": 0},
        "rounding_policy": {"type": "string", "minLength": 1},
        "schema_version": {"const": 1}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actual", "budget", "budget_id", "category", "flow_type", "period", "reason_code", "status", "transaction_ids", "variance"],
      "properties": {
        "actual": {"$ref": "#/$defs/money"},
        "budget": {"anyOf": [{"$ref": "#/$defs/money"}, {"type": "null"}]},
        "budget_id": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "category": {"type": "string", "minLength": 1},
        "flow_type": {"enum": ["income", "expense"]},
        "period": {"type": "string", "pattern": "^\\d{4}-\\d{2}$"},
        "reason_code": {"type": "string", "minLength": 1},
        "status": {"enum": ["within_budget", "over_budget", "unbudgeted", "no_activity"]},
        "transaction_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "variance": {"anyOf": [{"$ref": "#/$defs/money"}, {"type": "null"}]}
      }
    }
  }
}
