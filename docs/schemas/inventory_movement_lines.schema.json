{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reconforge.local/schemas/inventory_movement_lines.schema.json",
  "title": "ReconForge Inventory Movement Lines",
  "description": "Strict local JSON input for exact-quantity inventory movement lines. Direction, scope, stock, tracking, and period rules are enforced by the service.",
  "oneOf": [
    {"$ref": "#/$defs/lines"},
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["lines"],
      "properties": {"lines": {"$ref": "#/$defs/lines"}}
    }
  ],
  "$defs": {
    "code": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "location": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}/[A-Za-z0-9][A-Za-z0-9._-]{0,63}$", "maxLength": 129},
    "amount": {"type": "string", "pattern": "^(0|[0-9]+)(\\.[0-9]+)?$", "maxLength": 64},
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_code", "quantity"],
      "properties": {
        "item_code": {"$ref": "#/$defs/code"},
        "quantity": {"$ref": "#/$defs/amount"},
        "from_location": {"oneOf": [{"$ref": "#/$defs/location"}, {"const": ""}]},
        "to_location": {"oneOf": [{"$ref": "#/$defs/location"}, {"const": ""}]},
        "lot_serial_code": {"oneOf": [{"$ref": "#/$defs/code"}, {"const": ""}]},
        "description": {"type": "string", "maxLength": 500}
      }
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/line"}
    }
  }
}
