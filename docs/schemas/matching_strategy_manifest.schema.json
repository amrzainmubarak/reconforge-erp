{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reconforge.local/schemas/matching_strategy_manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "strategies"],
  "properties": {
    "schema_version": {"const": 1},
    "strategies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "maturity", "algorithm", "supported_modes", "deterministic_tie_break", "explanation_schema", "limits"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "maturity": {"enum": ["experimental", "beta", "stable"]},
          "algorithm": {"type": "string", "minLength": 1, "maxLength": 200},
          "supported_modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "deterministic_tie_break": {"type": "string", "minLength": 1, "maxLength": 200},
          "explanation_schema": {"type": "string", "minLength": 1, "maxLength": 100},
          "limits": {
            "type": "object",
            "additionalProperties": false,
            "required": ["max_left_records", "max_right_records", "max_candidates_per_record", "max_total_candidate_evaluations", "max_date_window_days", "max_amount_text_characters"],
            "properties": {
              "max_left_records": {"type": "integer", "minimum": 1},
              "max_right_records": {"type": "integer", "minimum": 1},
              "max_candidates_per_record": {"type": "integer", "minimum": 1},
              "max_total_candidate_evaluations": {"type": "integer", "minimum": 1},
              "max_date_window_days": {"type": "integer", "minimum": 1},
              "max_amount_text_characters": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    }
  }
}
