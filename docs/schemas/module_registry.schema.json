{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reconforge.local/schemas/module_registry.schema.json",
  "title": "ReconForge Runtime Module Registry",
  "description": "Deterministic metadata for implemented and foundation-stage local runtime modules. Planned-only work is excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_version", "local_first", "external_calls", "modules"],
  "properties": {
    "schema_version": {"const": 1},
    "package_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "local_first": {"const": true},
    "external_calls": {"const": false},
    "modules": {
      "type": "array",
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/module"}
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 500},
    "name": {"type": "string", "minLength": 1, "maxLength": 160},
    "names": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/name"}
    },
    "testPath": {
      "allOf": [
        {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(tests|apps/web)/[A-Za-z0-9_./-]+$"},
        {"not": {"pattern": "(^|/)\\.\\.(/|$)"}}
      ]
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_id",
        "name",
        "version",
        "maturity",
        "capability_status",
        "summary",
        "local_first",
        "external_calls",
        "network_requirement",
        "default_enabled",
        "dependencies",
        "incompatible_with",
        "permissions",
        "migration_versions",
        "domain_events",
        "interfaces",
        "import_contracts",
        "export_contracts",
        "data_classification",
        "retention_note",
        "activation_note",
        "test_evidence"
      ],
      "properties": {
        "module_id": {"type": "string", "maxLength": 80, "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "maturity": {"enum": ["stable", "beta", "experimental"]},
        "capability_status": {"enum": ["implemented", "foundation"]},
        "summary": {"$ref": "#/$defs/text"},
        "local_first": {"const": true},
        "external_calls": {"const": false},
        "network_requirement": {"enum": ["none", "loopback-optional"]},
        "default_enabled": {"type": "boolean"},
        "dependencies": {"$ref": "#/$defs/names"},
        "incompatible_with": {"$ref": "#/$defs/names"},
        "permissions": {"$ref": "#/$defs/names"},
        "migration_versions": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "domain_events": {"$ref": "#/$defs/names"},
        "interfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["cli", "api", "current-studio", "modern-studio", "artifacts", "library"]}
        },
        "import_contracts": {"$ref": "#/$defs/names"},
        "export_contracts": {"$ref": "#/$defs/names"},
        "data_classification": {"$ref": "#/$defs/names"},
        "retention_note": {"$ref": "#/$defs/text"},
        "activation_note": {"$ref": "#/$defs/text"},
        "test_evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/testPath"}
        }
      }
    }
  }
}
