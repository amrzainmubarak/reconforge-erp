{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reconforge.local/schemas/ownership-change-adjustment-v1.schema.json",
  "title": "ReconForge ownership-change adjustment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "algorithm_version", "change_id", "lines", "new_nci_percentage",
    "nci_rounding_delta", "posted", "prior_nci_percentage",
    "reporting_currency", "request_digest", "result_digest", "schema_version",
    "unrounded_nci_effect"
  ],
  "properties": {
    "algorithm_version": {"const": "ownership-change-adjustment-v1"},
    "change_id": {"type": "string", "minLength": 1},
    "lines": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["account_code", "amount", "line_type", "source_reference"],
        "properties": {
          "account_code": {"type": "string", "minLength": 1},
          "amount": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema_version", "amount", "currency", "minor_units",
              "rounding_policy", "currency_policy_digest",
              "currency_registry_version", "currency_registry_digest"
            ],
            "properties": {
              "schema_version": {"const": 1},
              "amount": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
              "currency": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{2,5}$"},
              "minor_units": {"type": "integer", "minimum": 0, "maximum": 8},
              "rounding_policy": {"const": "ROUND_HALF_UP"},
              "currency_policy_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "currency_registry_version": {"type": "string", "minLength": 1, "maxLength": 128},
              "currency_registry_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          },
          "line_type": {"enum": ["nci", "consideration", "parent_equity"]},
          "source_reference": {"type": "string", "minLength": 1}
        }
      }
    },
    "new_nci_percentage": {"type": "string"},
    "nci_rounding_delta": {"type": "string"},
    "posted": {"const": false},
    "prior_nci_percentage": {"type": "string"},
    "reporting_currency": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{2,5}$"},
    "request_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "result_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "schema_version": {"const": 1},
    "unrounded_nci_effect": {"type": "string"}
  }
}
