{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reconforge.local/schema/postgres-durable-job-scale-v1.json",
  "title": "ReconForge PostgreSQL durable-job 10K scale result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "workers",
    "jobs",
    "jobs_per_tenant",
    "partitions_per_job",
    "tenants",
    "declared_partition_effects",
    "completed_jobs",
    "committed_partition_effects",
    "duplicate_partition_effects",
    "final_queue_depth",
    "final_running_depth",
    "per_tenant_completions",
    "effect_set_digest",
    "observed_runtime_seconds",
    "observed_throughput_jobs_per_second",
    "environment",
    "manifest_digest",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "profile_id": {"const": "postgres-durable-job-load/10k-effects-v1"},
    "workers": {"const": 16},
    "jobs": {"const": 2500},
    "jobs_per_tenant": {"const": 625},
    "partitions_per_job": {"const": 4},
    "tenants": {"const": 4},
    "declared_partition_effects": {"const": 10000},
    "completed_jobs": {"const": 2500},
    "committed_partition_effects": {"const": 10000},
    "duplicate_partition_effects": {"const": 0},
    "final_queue_depth": {"const": 0},
    "final_running_depth": {"const": 0},
    "per_tenant_completions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lane-00": {"const": 625},
        "lane-01": {"const": 625},
        "lane-02": {"const": 625},
        "lane-03": {"const": 625}
      },
      "required": ["lane-00", "lane-01", "lane-02", "lane-03"]
    },
    "effect_set_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observed_runtime_seconds": {"type": "number", "minimum": 0},
    "observed_throughput_jobs_per_second": {"type": "number", "minimum": 0},
    "environment": {"type": "object"},
    "manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "limitations": {"type": "array", "minItems": 4, "items": {"type": "string"}}
  }
}
