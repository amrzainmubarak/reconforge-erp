{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reconforge.local/schemas/release_manifest.schema.json",
  "title": "ReconForge release candidate manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release",
    "builder",
    "artifacts",
    "verification_requirements",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "version",
        "source_repository",
        "source_revision",
        "source_date_epoch",
        "signed_annotated_tag_required"
      ],
      "properties": {
        "tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "source_repository": { "const": "https://github.com/amrzainmubarak/reconforge-erp" },
        "source_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "source_date_epoch": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "signed_annotated_tag_required": { "const": true }
      }
    },
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow_identity", "runner_class", "assessment"],
      "properties": {
        "workflow_identity": {
          "const": "amrzainmubarak/reconforge-erp/.github/workflows/release.yml"
        },
        "runner_class": { "const": "github-hosted" },
        "assessment": { "const": "UNEVALUATED" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        { "$ref": "#/$defs/source" },
        { "$ref": "#/$defs/wheel" },
        { "$ref": "#/$defs/sdist" },
        { "$ref": "#/$defs/image" }
      ],
      "items": false
    },
    "verification_requirements": {
      "const": [
        "sha256-subject-match",
        "expected-repository",
        "expected-workflow",
        "expected-source-ref",
        "expected-source-revision",
        "deny-self-hosted-runner"
      ]
    },
    "claim_boundary": { "type": "string", "minLength": 100 }
  },
  "$defs": {
    "commonArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "location", "media_type", "sha256"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "minLength": 1 },
        "media_type": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "source": {
      "allOf": [
        { "$ref": "#/$defs/commonArtifact" },
        {
          "properties": {
            "id": { "const": "source-archive" },
            "name": { "pattern": "^reconforge-erp-[0-9]+\\.[0-9]+\\.[0-9]+-source\\.tar\\.gz$" },
            "location": { "pattern": "^reconforge-erp-[0-9]+\\.[0-9]+\\.[0-9]+-source\\.tar\\.gz$" },
            "media_type": { "const": "application/gzip" }
          }
        }
      ]
    },
    "wheel": {
      "allOf": [
        { "$ref": "#/$defs/commonArtifact" },
        {
          "properties": {
            "id": { "const": "python-wheel" },
            "name": { "pattern": "^reconforge_erp-[0-9]+\\.[0-9]+\\.[0-9]+-py3-none-any\\.whl$" },
            "location": { "pattern": "^reconforge_erp-[0-9]+\\.[0-9]+\\.[0-9]+-py3-none-any\\.whl$" },
            "media_type": { "const": "application/vnd.pypa.wheel+zip" }
          }
        }
      ]
    },
    "sdist": {
      "allOf": [
        { "$ref": "#/$defs/commonArtifact" },
        {
          "properties": {
            "id": { "const": "python-sdist" },
            "name": { "pattern": "^reconforge_erp-[0-9]+\\.[0-9]+\\.[0-9]+\\.tar\\.gz$" },
            "location": { "pattern": "^reconforge_erp-[0-9]+\\.[0-9]+\\.[0-9]+\\.tar\\.gz$" },
            "media_type": { "const": "application/gzip" }
          }
        }
      ]
    },
    "image": {
      "allOf": [
        { "$ref": "#/$defs/commonArtifact" },
        {
          "properties": {
            "id": { "const": "container-image" },
            "name": { "const": "ghcr.io/amrzainmubarak/reconforge-erp" },
            "location": {
              "pattern": "^ghcr\\.io/amrzainmubarak/reconforge-erp@sha256:[0-9a-f]{64}$"
            },
            "media_type": { "const": "application/vnd.oci.image.manifest.v1+json" }
          }
        }
      ]
    }
  }
}
