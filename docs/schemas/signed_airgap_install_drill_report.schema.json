{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reconforge.local/schemas/signed_airgap_install_drill_report.schema.json",
  "title": "ReconForge signed artifact no-network installation drill",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "executed_at", "release_identity", "signature_evidence", "installation", "scope_status", "limitations"],
  "properties": {
    "schema": {"const": "reconforge-signed-airgap-install-drill-report-v1"},
    "executed_at": {"const": "2026-07-30"},
    "release_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "tag", "revision", "wheel_sha256", "actions_run_id", "artifact_id"],
      "properties": {
        "version": {"const": "0.7.1"},
        "tag": {"const": "v0.7.1"},
        "revision": {"const": "d47edd845e6aef3bae16e05698e07878086d690b"},
        "wheel_sha256": {"const": "210e69770fe1ad55227173349ee22ca7f16e4f5270c093f12c78460c14b66f33"},
        "actions_run_id": {"const": 30243819239},
        "artifact_id": {"const": 8644255664}
      }
    },
    "signature_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["offline_provenance_verified", "offline_cyclonedx_attestation_verified", "repository_workflow_ref_commit_runner_constrained"],
      "properties": {
        "offline_provenance_verified": {"const": true},
        "offline_cyclonedx_attestation_verified": {"const": true},
        "repository_workflow_ref_commit_runner_constrained": {"const": true}
      }
    },
    "installation": {
      "type": "object", "additionalProperties": false,
      "required": ["container_image", "container_image_digest", "network_mode", "root_filesystem", "bundle_mount", "pip_policy", "entry_count", "total_bytes", "bundle_manifest_sha256", "doctor_exit_zero", "cleanup_complete"],
      "properties": {
        "container_image": {"const": "python:3.14.1-slim"},
        "container_image_digest": {"const": "sha256:b823ded4377ebb5ff1af5926702df2284e53cecbc6e3549e93a19d8632a1897e"},
        "network_mode": {"const": "none"},
        "root_filesystem": {"const": "read-only"},
        "bundle_mount": {"const": "read-only"},
        "pip_policy": {"const": "--no-index --no-deps --require-hashes"},
        "entry_count": {"const": 60},
        "total_bytes": {"const": 98398601},
        "bundle_manifest_sha256": {"const": "7f0193e5d5b3cf0a1b6c20c6b4bda79ff480bbc405d89b070c13589f3e1829b2"},
        "doctor_exit_zero": {"const": true},
        "cleanup_complete": {"const": true}
      }
    },
    "scope_status": {"const": "verified-same-signed-wheel-installed-without-network"},
    "limitations": {
      "type": "array", "minItems": 5, "uniqueItems": true,
      "items": {"enum": ["python_wheel_profile_only", "dependency_wheels_hash_verified_not_individually_attested", "single_runtime_single_run", "no_physical_transfer_custody_claim", "no_production_readiness_claim"]}
    }
  }
}
