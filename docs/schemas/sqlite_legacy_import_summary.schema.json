{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reconforge.local/schemas/sqlite-legacy-import-summary-object-v1",
  "title": "ReconForge SQLite Legacy Import Summary Object v1",
  "description": "Structural contract for bounded legacy_import_records summary objects. Finite JSON numbers remain accepted for stored compatibility; financial values require their established exact representations.",
  "$ref": "#/$defs/object",
  "$defs": {
    "value": {
      "oneOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "string"},
        {"type": "number"},
        {"$ref": "#/$defs/array"},
        {"$ref": "#/$defs/object"}
      ]
    },
    "array": {
      "type": "array",
      "items": {"$ref": "#/$defs/value"},
      "maxItems": 25000
    },
    "object": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/value"},
      "maxProperties": 25000
    }
  }
}
