{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reconforge.local/schemas/sqlite-matching-lineage-object-v1",
  "title": "ReconForge SQLite Matching Lineage Object v1",
  "description": "Structural contract for bounded SQLite match_results lineage objects. The public database export retains the historical lineage_json string field after validation.",
  "$ref": "#/$defs/object",
  "$defs": {
    "value": {
      "oneOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "string"},
        {"type": "number"},
        {"$ref": "#/$defs/array"},
        {"$ref": "#/$defs/object"}
      ]
    },
    "array": {
      "type": "array",
      "items": {"$ref": "#/$defs/value"},
      "maxItems": 25000
    },
    "object": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/value"},
      "maxProperties": 25000
    }
  }
}
