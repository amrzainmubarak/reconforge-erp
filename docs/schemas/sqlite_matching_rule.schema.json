{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reconforge.local/schemas/sqlite-matching-rule-object-v1",
  "title": "ReconForge SQLite Matching Rule Object v1",
  "description": "Structural contract for bounded SQLite match_jobs and match_rules rule objects. New financial amounts use exact text; finite JSON numbers remain readable only for historical compatibility.",
  "$ref": "#/$defs/object",
  "$defs": {
    "value": {
      "oneOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "string"},
        {"type": "number"},
        {"$ref": "#/$defs/array"},
        {"$ref": "#/$defs/object"}
      ]
    },
    "array": {
      "type": "array",
      "items": {"$ref": "#/$defs/value"},
      "maxItems": 25000
    },
    "object": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/value"},
      "maxProperties": 25000
    }
  }
}
