{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reconforge.local/schemas/upgrade_plan.schema.json",
  "title": "ReconForge multi-resource upgrade plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "plan_id", "operator_application_version", "current_application_version", "target_application_version", "release_manifest_sha256", "steps"],
  "properties": {
    "schema": {"const": "reconforge-upgrade-plan-v1"},
    "plan_id": {"type": "string", "pattern": "^UPG-[A-Z0-9][A-Z0-9-]{5,63}$"},
    "operator_application_version": {"$ref": "#/$defs/semver"},
    "current_application_version": {"$ref": "#/$defs/semver"},
    "target_application_version": {"$ref": "#/$defs/semver"},
    "release_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "steps": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {"$ref": "#/$defs/step"}
    }
  },
  "$defs": {
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "resource_id", "from_version", "to_version", "target_sha256", "rollback_required", "compatibility_reader"],
      "properties": {
        "kind": {"enum": ["application", "database", "object_store", "configuration", "pack"]},
        "resource_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 100},
        "from_version": {"$ref": "#/$defs/semver"},
        "to_version": {"$ref": "#/$defs/semver"},
        "target_sha256": {"$ref": "#/$defs/sha256"},
        "rollback_required": {"const": true},
        "compatibility_reader": {"type": "string", "minLength": 1, "maxLength": 120}
      }
    }
  }
}
