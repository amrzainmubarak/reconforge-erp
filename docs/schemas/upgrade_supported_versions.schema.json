{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reconforge.local/schemas/upgrade_supported_versions.schema.json",
  "title": "ReconForge supported upgrade transition matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "operator_version", "release_state", "transitions"],
  "properties": {
    "schema": {"const": "reconforge-upgrade-supported-versions-v1"},
    "operator_version": {"$ref": "#/$defs/semver"},
    "release_state": {"enum": ["candidate", "supported"]},
    "transitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"$ref": "#/$defs/transition"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"release_state": {"const": "supported"}}, "required": ["release_state"]},
      "then": {
        "properties": {
          "transitions": {
            "items": {
              "allOf": [
                {"$ref": "#/$defs/transition"},
                {"properties": {"status": {"const": "verified"}}, "required": ["status"]}
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_kind", "resource_id", "from_version", "to_version", "compatibility_reader", "rollback", "evidence", "status"],
      "properties": {
        "resource_kind": {"enum": ["application", "database", "object_store", "configuration", "pack"]},
        "resource_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 100},
        "from_version": {"$ref": "#/$defs/semver"},
        "to_version": {"$ref": "#/$defs/semver"},
        "compatibility_reader": {"type": "string", "minLength": 1, "maxLength": 120},
        "rollback": {"const": "required"},
        "evidence": {"type": "string", "minLength": 1, "maxLength": 240},
        "status": {"enum": ["verified", "blocked"]},
        "blocker": {"type": "string", "minLength": 1, "maxLength": 240}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "blocked"}}, "required": ["status"]},
          "then": {"required": ["blocker"]},
          "else": {"not": {"required": ["blocker"]}}
        }
      ]
    }
  }
}
